# Runtime
APP_ENV=development
PORT=3000
RUST_LOG=info,vvcoffice=debug

# Session policy
SESSION_IDLE_SECS=1800
SESSION_ABSOLUTE_SECS=28800
MAX_BODY_BYTES=1048576
# Keep true for HTTPS Preview/production. Set false only for local HTTP smoke tests.
COOKIE_SECURE=true

# Local bootstrap only. Replace in every deployed environment.
VVC_DEV_PASSWORD=replace-with-a-long-random-bootstrap-password
VVC_BOOTSTRAP_EMAIL=security@example.com

# Required when the origin is reachable outside Cloudflare. Keep only in server secret stores.
VVC_GATEWAY_SECRET=replace-with-rotated-origin-verification-secret

# Supabase PostgreSQL connection for the trusted backend only. Never commit the real password.
# vvc_office project ref: dcygkewrgyeawkghuxmd
DATABASE_URL=replace-with-vvc-office-supabase-postgres-connection-string
REDIS_URL=redis://host:6379/0
# Preview may leave REDIS_URL unset and uses a process-local fallback.
# Production requires a reachable Redis instance; startup/readiness fail otherwise.

# Optional OpenTelemetry exporter configuration
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.invalid
OTEL_SERVICE_NAME=vvcoffice
