# Runtime
APP_ENV=development
PORT=3000
RUST_LOG=info,vvcoffice=debug

# Session policy
SESSION_IDLE_SECS=1800
SESSION_ABSOLUTE_SECS=28800
MAX_BODY_BYTES=1048576
# Keep true for HTTPS Preview/production. Set false only for local HTTP smoke tests.
COOKIE_SECURE=true

# Local bootstrap only. Replace in every deployed environment.
VVC_DEV_PASSWORD=replace-with-a-long-random-bootstrap-password
VVC_BOOTSTRAP_EMAIL=security@example.com

# Required in every deployed environment (production, preview, staging) —
# the server refuses to start without it outside local development.
# Keep only in server secret stores.
VVC_GATEWAY_SECRET=replace-with-rotated-origin-verification-secret

# Supabase PostgreSQL connection for the trusted backend only. Never commit
# the real password, and never put a project ref or hostname here — the
# connection string alone identifies the database to the backend.
# Use the least-privilege `vvc_app` role (see
# migrations/least_privilege_role.sql), never the service-role key.
DATABASE_URL=replace-with-vvc-office-supabase-postgres-connection-string
REDIS_URL=redis://host:6379/0
# Preview may leave REDIS_URL unset and uses a process-local fallback.
# Production requires a reachable Redis instance; startup/readiness fail otherwise.

# Optional extra CORS origins, comma-separated, in addition to
# https://vvc-office.pages.dev. Leave empty unless another frontend
# origin genuinely needs to call the API cross-origin.
ALLOWED_ORIGINS=

# Operational log retention, in days (default 90). Audit logs are never
# deleted by retention.
LOG_RETENTION_DAYS=90

# Optional OpenTelemetry exporter configuration
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.invalid
OTEL_SERVICE_NAME=vvcoffice
