# Runtime
APP_ENV=development
PORT=3000
RUST_LOG=info,aegiscore=debug

# Session policy
SESSION_IDLE_SECS=1800
SESSION_ABSOLUTE_SECS=28800
MAX_BODY_BYTES=1048576
# Keep true for HTTPS Preview/production. Set false only for local HTTP smoke tests.
COOKIE_SECURE=true

# Local bootstrap only. Replace in every deployed environment.
AEGIS_DEV_PASSWORD=replace-with-a-long-random-bootstrap-password

# Required when the origin is reachable outside Cloudflare. Keep only in server secret stores.
AEGIS_GATEWAY_SECRET=replace-with-rotated-origin-verification-secret

# Production persistence integrations (wired by the deployment adapter described in README)
DATABASE_URL=postgresql://user:password@host:5432/aegiscore
REDIS_URL=redis://host:6379/0

# Optional OpenTelemetry exporter configuration
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.invalid
OTEL_SERVICE_NAME=aegiscore
